---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  pubDate?: Date;
  category?: string;
  tags?: string[];
}

const { title, description = '', pubDate, category, tags = [] } = Astro.props;

const dateFormat = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-3xl">
    <a
      href="/"
      class="inline-flex items-center gap-1 text-sm text-slate-500 transition hover:text-brand-700"
    >
      ← 記事一覧へ戻る
    </a>

    <article class="mt-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-10">
      <header class="border-b border-slate-100 pb-6">
        <div class="flex flex-wrap items-center gap-2.5 text-xs text-slate-500">
          {
            category && (
              <span class="rounded-full bg-brand-50 px-2.5 py-1 font-medium text-brand-700 ring-1 ring-brand-100">
                {category}
              </span>
            )
          }
          {
            pubDate && (
              <time datetime={pubDate.toISOString()}>{dateFormat.format(pubDate)}</time>
            )
          }
        </div>
        <h1 class="mt-3 text-2xl font-bold leading-snug tracking-tight text-slate-900 sm:text-3xl">
          {title}
        </h1>
        {
          tags.length > 0 && (
            <p class="mt-3 text-xs text-slate-400">
              {tags.map((tag) => `#${tag}`).join('  ')}
            </p>
          )
        }
      </header>

      <div
        class="prose prose-slate mt-8 max-w-none
          prose-headings:scroll-mt-20 prose-headings:font-bold prose-headings:text-slate-900
          prose-h2:mt-12 prose-h2:border-l-4 prose-h2:border-brand-500 prose-h2:pl-3 prose-h2:text-xl sm:prose-h2:text-2xl
          prose-h3:mt-8 prose-h3:text-lg
          prose-p:leading-[1.9] prose-p:text-slate-700
          prose-a:text-brand-700 prose-a:underline-offset-2
          prose-strong:text-slate-900
          prose-blockquote:rounded-r-xl prose-blockquote:border-l-4 prose-blockquote:border-brand-500
          prose-blockquote:bg-brand-50/60 prose-blockquote:px-5 prose-blockquote:py-3
          prose-blockquote:not-italic prose-blockquote:text-slate-700
          prose-li:leading-[1.9] prose-li:text-slate-700
          prose-table:text-sm prose-th:bg-slate-50
          prose-hr:border-slate-200"
      >
        <slot />
      </div>
    </article>

    <a
      href="/"
      class="mt-8 inline-flex items-center gap-1 text-sm text-slate-500 transition hover:text-brand-700"
    >
      ← 記事一覧へ戻る
    </a>
  </div>
</BaseLayout>
