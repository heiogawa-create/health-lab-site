---
// サイトのイメージキャラクター（妖精の白衣キャラ）を表示する共通コンポーネント。
// 画像は public/images/character/ 配下。差し替え手順は同ディレクトリのREADME参照。
export type Pose = 'note' | 'phone' | 'check';

interface Props {
  /** note: クリップボードに記入（監修・解説向け） / phone: スマホでチェック（CTA・行動喚起向け） / check: チェックリスト提示（まとめ・ポイント向け） */
  pose?: Pose;
  /** 吹き出しに表示するセリフ。省略時はキャラクターのみ表示 */
  message?: string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { pose = 'check', message, size = 'md', class: className = '' } = Astro.props;

const images: Record<Pose, string> = {
  note: '/images/character/hey-fairy-note.png',
  phone: '/images/character/hey-fairy-phone.png',
  check: '/images/character/hey-fairy-check.png',
};

const sizeClasses = {
  sm: 'h-16 w-16',
  md: 'h-24 w-24',
  lg: 'h-36 w-36',
};
---

<div class={`not-prose my-6 flex items-center gap-4 ${className}`}>
  <img
    src={images[pose]}
    alt="ヘイの健康ラボのイメージキャラクター"
    class={`${sizeClasses[size]} shrink-0 object-contain`}
    loading="lazy"
    decoding="async"
  />
  {
    message && (
      <div class="relative rounded-2xl border border-cyan-200 bg-cyan-50 px-4 py-3 text-sm leading-relaxed text-gray-800">
        <span
          class="absolute top-1/2 -left-2 h-4 w-4 -translate-y-1/2 rotate-45 border-b border-l border-cyan-200 bg-cyan-50"
          aria-hidden="true"
        />
        {message}
      </div>
    )
  }
</div>
